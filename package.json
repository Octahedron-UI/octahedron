{
  "name": "octahedron",
  "version": "0.1.2",
  "description": "A dark-first React component library with light/dark themes, CSS custom properties, and 70+ production-ready components.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./brand.css": "./dist/brand.css",
    "./tokens.css": "./dist/tokens.css",
    "./codemirror-theme.css": "./dist/codemirror-theme.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && cp src/brand.css dist/brand.css && cp src/tokens.css dist/tokens.css && cp src/codemirror-theme.css dist/codemirror-theme.css",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist",
    "docs": "vite --config docs/vite.config.ts",
    "docs:build": "vite build --config docs/vite.config.ts"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.16"
  },
  "peerDependencies": {
    "@untitledui/icons": "^0.0.19",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-router-dom": "^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "react-router-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@untitledui/icons": "^0.0.22",
    "@vitejs/plugin-react": "^4.7.0",
    "postcss": "^8.5.0",
    "postcss-modules": "^6.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arciops/octahedron"
  },
  "keywords": [
    "react",
    "components",
    "design-system",
    "css-modules",
    "dark-theme",
    "ui"
  ]
}
